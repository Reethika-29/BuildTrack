<%- include('./common/navbar', { role, currentPage }); %>
    <!DOCTYPE html>
    <html lang="en">

    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>Milestone Stages and Contractors</title>
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/4.5.2/css/bootstrap.min.css">
        <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;700&display=swap" rel="stylesheet">
        <style>
            body {
                background-color: #343a40;
                /* Dark background */
                color: #201e1e;
                /* White text for better contrast */
                font-family: 'Roboto', sans-serif;
            }

            h1 {
                color: rgb(245, 190, 9);
                /* Header color */
                text-align: center;
                margin-top: 20px;
                font-weight: 700;
            }

            .table {
                background-color: rgba(255, 255, 255, 0.4);
                /* Slightly transparent white for table background */
                border-radius: 5px;
                border: 1px solid rgb(245, 190, 9);
                /* Border for table */
            }

            th {
                background-color: rgb(245, 190, 9);
                color: rgb(75, 72, 72);
                text-align: center;
            }

            td {
                text-align: center;
                padding: 10px;
                /* Add padding for better spacing */
            }

            .container {
                margin-top: 30px;
                padding: 20px;
                border-radius: 10px;
                background-color: rgba(255, 255, 255, 0.2);
                /* Slightly transparent white for container background */
                box-shadow: 0 4px 10px rgba(0, 0, 0, 0.3);
                /* Shadow for depth */
                max-width: 1200px;
                /* Limit the width of the container */
                margin-left: auto;
                /* Center the container */
                margin-right: auto;
                /* Center the container */
            }

            .no-items {
                text-align: center;
                margin-top: 20px;
                font-size: 18px;
                color: rgb(245, 190, 9);
                /* Color for no items message */
            }

            .dashboard-btn {
                position: fixed;
                bottom: 20px;
                /* Positioning from the bottom */
                left: 20px;
                /* Positioning from the left */
                z-index: 1000;
            }

            /* Hover effect for table rows */
            tbody tr:hover {
                background-color: rgba(245, 190, 9, 0.2);
            }

            #content-to-print {
                overflow: auto;
                /* Enables scrolling */
            }
        </style>
    </head>

    <body>
        <h1 class="mt-5">Milestones</h1>
        <center>
            <% if (items.length> 0) { %>
                <form action="/submit-budget/" method="POST">
                    <input type="hidden" name="projectId" value="<%= project.id %>">
                    <input type="hidden" name="editedBudgets" id="edited-budgets" value="">

                    <table class="table mt-3">
                        <thead>
                            <tr>
                                <th>Stage</th>
                                <th>Name</th>
                                <th>Estimated Budget</th>
                                <th>Total Stage Amount</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% items.forEach(item=> { %>
                                <% item.stages.forEach(stage=> { %>
                                    <tr>
                                        <td>
                                            <%= stage.stage %>
                                        </td>
                                        <td>
                                            <%= stage.name %>
                                        </td>
                                        <td>
                                            <span class="estimated-budget" id="budget-<%= stage.stage %>">
                                                <%= estimatedBudgetMap.get(stage.stage.toString()) || '0' %>
                                            </span>
                                            <input type="number" class="form-control d-none"
                                                id="edit-budget-<%= stage.stage %>"
                                                value="<%= estimatedBudgetMap.get(stage.stage.toString()) || '0' %>">
                                        </td>

                                        <td>
                                            <%= stageAmountMap.get(stage.stage) || 'N/A' %>
                                                <!-- Display totalStageAmount or 'N/A' if not found -->
                                        </td>
                                        <td>
                                            <button type="button" class="btn btn-secondary edit-budget"
                                                data-stage="<%= stage.stage %>">Edit</button>
                                            <button type="button" class="btn btn-success save-budget d-none"
                                                data-stage="<%= stage.stage %>">Save</button>
                                        </td>
                                    </tr>
                                    <% }) %>
                                        <% }) %>
                        </tbody>
                    </table>
                    <button type="submit" class="btn btn-primary mt-3">Submit Budget</button>
                </form>
                <% } else { %>
                    <p class="no-items">No milestone stages found.</p>
                    <% } %>
        </center>
        <script>
            // JavaScript to handle edit and save functionality
            document.querySelectorAll('.edit-budget').forEach(button => {
                button.addEventListener('click', function () {
                    const stage = this.getAttribute('data-stage');
                    const budgetSpan = document.getElementById(`budget-${stage}`);
                    const budgetInput = document.getElementById(`edit-budget-${stage}`);
                    const saveButton = this.nextElementSibling; // Save button
                    const editButton = this; // Edit button

                    // Show input and hide span
                    budgetSpan.classList.add('d-none');
                    budgetInput.classList.remove('d-none');
                    budgetInput.focus();

                    // Show the save button and hide the edit button
                    saveButton.classList.remove('d-none');
                    editButton.classList.add('d-none');
                });
            });

            document.querySelectorAll('.save-budget').forEach(button => {
                button.addEventListener('click', function () {
                    const stage = this.getAttribute('data-stage');
                    const budgetSpan = document.getElementById(`budget-${stage}`);
                    const budgetInput = document.getElementById(`edit-budget-${stage}`);
                    const editButton = this.previousElementSibling; // Edit button

                    // Update the displayed budget value
                    budgetSpan.innerText = budgetInput.value;

                    // Hide input and show span
                    budgetSpan.classList.remove('d-none');
                    budgetInput.classList.add('d-none');

                    // Show the edit button and hide the save button
                    editButton.classList.remove('d-none');
                    this.classList.add('d-none');

                    // Update the hidden input with the new budget value
                    // Update the hidden input with the new budget value
                    const editedBudgets = JSON.parse(document.getElementById('edited-budgets').value || '{}');
                    editedBudgets[stage] = budgetInput.value; // Store the updated budget
                    document.getElementById('edited-budgets').value = JSON.stringify(editedBudgets); // Convert back to string

                });
            });

        </script>

        <div class="dashboard-btn">
            <a href="/projects/<%= project.id %>/edit" class="btn"
                style="background-color: rgb(245, 190, 9); color: rgb(75, 72, 72); padding: 10px 20px; border: none; border-radius: 4px; cursor: pointer;">Dashboard</a>
        </div>
    </body>

    </html>