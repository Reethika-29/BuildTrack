<%- include('./common/navbar', { role, currentPage }); %>
    <!DOCTYPE html>
    <html lang="en">

    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>Project Photos</title>
        <style>
            .body {
                font-family: Arial, sans-serif;
                background: url('/images/pattern.png') no-repeat center center fixed;
                background-size: cover;
                margin: 0;
                padding: 20px;
            }

            h1 {
                text-align: center;
                color: rgb(245, 190, 9);
            }

            #photoForm {
                display: flex;
                justify-content: center;
                flex-wrap: wrap;
                /* Allow wrapping on smaller screens */
                margin-bottom: 20px;
            }

            input[type="text"],
            input[type="file"],
            select {
                padding: 10px;
                border: none;
                border-radius: 5px;
                background-color: rgb(245, 190, 9);
                color: black;
                cursor: pointer;
                margin: 5px;
                /* Space between inputs */
            }

            button {
                padding: 10px 15px;
                border: none;
                border-radius: 5px;
                background-color: rgb(245, 190, 9);
                color: black;
                font-weight: bold;
                cursor: pointer;
                margin: 5px;
            }

            button:hover {
                background-color: rgb(220, 170, 0);
                /* Darker shade on hover */
            }

            #contentCard {
                background-color: rgba(0, 0, 0, 0.8);
                /* Transparent black */
                border-radius: 10px;
                padding: 20px;
                margin: 20px auto;
                width: 80%;
                /* Center the card and limit its width */
                color: white;
            }

            #photoGallery {
                display: flex;
                flex-wrap: wrap;
                justify-content: center;
                /* Center the photo gallery */
            }

            .photo-item {
                margin: 10px;
                background-color: rgba(255, 255, 255, 0.1);
                /* Semi-transparent white */
                border-radius: 8px;
                padding: 10px;
                /* Add some padding around the image */
            }

            .photo-item img {
                width: 300px;
                /* Fixed width */
                height: 200px;
                /* Fixed height */
                object-fit: cover;
                /* Keep aspect ratio within the bounds */
                border-radius: 5px;
                /* Rounded corners for images */
            }

            p {
                text-align: center;
                /* Center align text under images */
            }

            /* Media queries for responsiveness */
            @media (max-width: 768px) {
                #contentCard {
                    width: 95%;
                    /* Make the content card wider on small screens */
                }

                #photoForm {
                    flex-direction: column;
                    /* Stack form elements vertically */
                }

                input[type="text"],
                input[type="file"],
                select,
                button {
                    width: 100%;
                    /* Full-width inputs on small screens */
                    margin: 10px 0;
                    /* Add space between the form fields */
                }
            }

            @media (max-width: 480px) {
                h1 {
                    font-size: 24px;
                    /* Smaller font for h1 on tiny screens */
                }

                input[type="text"],
                input[type="file"],
                select,
                button {
                    padding: 8px;
                    /* Smaller padding for form fields */
                }
            }

            .dashboard-btn {
                position: fixed;
                bottom: 20px;
                /* Positioning from the bottom */
                left: 20px;
                /* Positioning from the left */
                z-index: 1000;
            }
        </style>
    </head>

    <body>
        <div id="contentCard">
            <h1>Site Photos</h1>

            <!-- Form to upload new photos -->
            <form id="photoForm" enctype="multipart/form-data" method="POST" action="/api/photos/<%= projectId %>">
                <select name="stage" required>
                    <option value="" disabled selected>Select Stage</option>
                    <% stages.forEach(stage=> { %>
                        <option value="<%= stage.name %>">Stage <%= stage.stage %>: <%= stage.name %>
                        </option>
                        <% }) %>
                </select>

                <input type="text" name="title" placeholder="Enter Photo Title" required> <!-- Title input -->
                <input type="file" name="photo" accept="image/*" required>
                <button type="submit">Upload Photo</button>
            </form>

            <div id="photoGallery">
                <% if (photos.length> 0) { %>
                    <% photos.forEach(photo=> { %>
                        <div class="photo-item">
                            <img src="/uploads/<%= photo.filename %>" alt="Photo">
                            <p><strong>
                                    <%= photo.title %>
                                </strong></p>
                            <p>Stage: <%= photo.stage ? photo.stage : "Not assigned" %>
                            </p> <!-- Display the stage -->
                            <!-- Delete button -->
                            <button onclick="deletePhoto('<%= photo._id %>')">Delete Photo</button>
                        </div>
                        <% }) %>
                            <% } else { %>
                                <p>No photos found for this project.</p>
                                <% } %>
            </div>
        </div>

        <script>
            const form = document.getElementById('photoForm');

            form.addEventListener('submit', async (e) => {
                e.preventDefault();
                const formData = new FormData(form);
                const projectId = '<%= projectId %>'; // Get project ID from EJS

                const response = await fetch(`/api/photos/${projectId}`, {
                    method: 'POST',
                    body: formData,
                });

                if (response.ok) {
                    alert('Photo uploaded successfully!');
                    location.reload(); // Reload the page to show the new photo
                } else {
                    alert('Error uploading photo.');
                }
            });

            async function deletePhoto(photoId) {
                const projectId = '<%= projectId %>'; // Get project ID from EJS
                const confirmDelete = confirm("Are you sure you want to delete this photo?");
                if (!confirmDelete) {
                    return; // Exit the function if the user cancels
                }
                const response = await fetch(`/api/photos/${projectId}/${photoId}`, {
                    method: 'DELETE',
                });

                if (response.ok) {
                    alert('Photo deleted successfully!');
                    location.reload(); // Reload the page to show updated photo list
                } else {
                    alert('Error deleting photo.');
                }
            }
        </script>
        <div class="dashboard-btn">
            <a href="/projects/<%= projectId %>/edit" class="btn"
                style="background-color: rgb(245, 190, 9); color: rgb(75, 72, 72); padding: 10px 20px; border: none; border-radius: 4px; cursor: pointer;">Dashboard</a>
        </div>
    </body>

    </html>