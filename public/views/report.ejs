<%- include('./common/navbar', { role, currentPage }); %>
    <!DOCTYPE html>
    <html lang="en">

    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>Milestone Stages and Contractors</title>
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/4.5.2/css/bootstrap.min.css">
        <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;700&display=swap" rel="stylesheet">
        <style>
            body {
                background-color: #343a40;
                /* Dark background */
                color: #201e1e;
                /* White text for better contrast */
                font-family: 'Roboto', sans-serif;
            }

            h1 {
                color: rgb(245, 190, 9);
                /* Header color */
                text-align: center;
                margin-top: 20px;
                font-weight: 700;
            }

            .table {
                background-color: rgba(255, 255, 255, 0.4);
                /* Slightly transparent white for table background */
                border-radius: 5px;
                border: 1px solid rgb(245, 190, 9);
                /* Border for table */
            }

            th {
                background-color: rgb(245, 190, 9);
                color: rgb(75, 72, 72);
                text-align: center;
            }

            td {
                text-align: center;
                padding: 10px;
                /* Add padding for better spacing */
            }

            .container {
                margin-top: 30px;
                padding: 20px;
                border-radius: 10px;
                background-color: rgba(255, 255, 255, 0.2);
                /* Slightly transparent white for container background */
                box-shadow: 0 4px 10px rgba(0, 0, 0, 0.3);
                /* Shadow for depth */
                max-width: 1200px;
                /* Limit the width of the container */
                margin-left: auto;
                /* Center the container */
                margin-right: auto;
                /* Center the container */
            }

            .no-items {
                text-align: center;
                margin-top: 20px;
                font-size: 18px;
                color: rgb(245, 190, 9);
                /* Color for no items message */
            }

            .dashboard-btn {
                position: fixed;
                bottom: 20px;
                /* Positioning from the bottom */
                left: 20px;
                /* Positioning from the left */
                z-index: 1000;
            }

            /* Hover effect for table rows */
            tbody tr:hover {
                background-color: rgba(245, 190, 9, 0.2);
            }

            #content-to-print {
                overflow: auto;
                /* Enables scrolling */
            }
        </style>
        <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
    </head>

    <body>
        <div class="container" id="content-to-print"> <!-- Added an ID for the content to be printed -->
            <h1>Project Details</h1>
            <center>
                <% if (projects.length> 0) { %>
                    <table class="table table-bordered">
                        <thead>
                            <tr>
                                <th>Title</th>
                                <th>Manager</th>
                                <th>Description</th>
                                <th>Location</th>
                                <th>Budget</th>
                                <th>Category</th>
                                <th>MD</th>

                            </tr>
                        </thead>
                        <tbody>
                            <% projects.forEach(project=> { %>
                                <tr>
                                    <td>
                                        <%= project.title %>
                                    </td>
                                    <td>
                                        <%= project.manager %>
                                    </td>
                                    <td>
                                        <%= project.description %>
                                    </td>
                                    <td>
                                        <%= project.location %>
                                    </td>
                                    <td>₹<%= project.budget.toFixed(2) %>
                                    </td>
                                    <td>
                                        <%= project.category %>
                                    </td>
                                    <td>
                                        <%= project.MD %>
                                    </td>

                                </tr>
                                <% }) %>
                        </tbody>
                    </table>
                    <% } else { %>
                        <p class="text-center">No projects found.</p>
                        <% } %>
            </center>

            <h1 class="mt-5">Milestones</h1>
            <center>
                <% if (items.length> 0) { %>
                    <table class="table mt-3">
                        <thead>
                            <tr>
                                <th>Stage</th>
                                <th>Name</th>
                                <th>Actual Start</th>
                                <th>Actual End</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% items.forEach(item=> { %>
                                <% item.stages.forEach(stage=> { %>
                                    <tr>
                                        <td>
                                            <%= stage.stage %>
                                        </td>
                                        <td>
                                            <%= stage.name %>
                                        </td>
                                        <td>
                                            <%= stage.actual.start ? stage.actual.start.toDateString() : 'N/A' %>
                                        </td>
                                        <td>
                                            <%= stage.actual.end ? stage.actual.end.toDateString() : 'N/A' %>
                                        </td>
                                    </tr>
                                    <% }) %>
                                        <% }) %>
                        </tbody>
                    </table>
                    <% } else { %>
                        <p class="no-items">No milestone stages found.</p>
                        <% } %>
            </center>
            <center>
                <!-- Bar chart for Milestone Stages -->
                <canvas id="milestoneChart" width="400" height="200"></canvas>
            </center>

            <h1 class="mt-5">Contractor Details</h1>
            <center>
                <% if (contractors.length> 0) { %>
                    <table class="table mt-3">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Details</th>
                                <th>Cost Estimate</th>
                                <th>From Date</th>
                                <th>To Date</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% contractors.forEach(contractor=> { %>
                                <tr>
                                    <td>
                                        <%= contractor.name %>
                                    </td>
                                    <td>
                                        <%= contractor.contact %>
                                    </td>
                                    <td>
                                        <%= contractor.costEstimate %>
                                    </td>
                                    <td>
                                        <%= contractor.fromDate ? contractor.fromDate.toDateString() : 'N/A' %>
                                    </td>
                                    <td>
                                        <%= contractor.toDate ? contractor.toDate.toDateString() : 'N/A' %>
                                    </td>
                                </tr>
                                <% }) %>
                        </tbody>
                    </table>
                    <% } else { %>
                        <p class="no-items">No contractor details found.</p>
                        <% } %>
            </center>
            <% if (role==='MD' ) { %>
                <h1 class="mt-5">Human Resource Details</h1>
                <center>
                    <% if (hrSchema.length> 0) { %>
                        <table class="table mt-3">
                            <thead>
                                <tr>
                                    <th>Name</th>
                                    <th>Designation</th>
                                    <th>Salary</th>
                                    <th>From Date</th>
                                    <th>To Date</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% hrSchema.forEach(hr=> { %>
                                    <tr>
                                        <td>
                                            <%= hr.name %>
                                        </td>
                                        <td>
                                            <%= hr.designation %>
                                        </td>
                                        <td>₹<%= hr.salary !==undefined ? hr.salary.toFixed(2) : 'N/A' %>
                                        </td>
                                        <td>
                                            <%= hr.fromDate ? hr.fromDate.toDateString() : 'N/A' %>
                                        </td>
                                        <td>
                                            <%= hr.toDate ? hr.toDate.toDateString() : 'N/A' %>
                                        </td>
                                    </tr>
                                    <% }) %>
                            </tbody>
                        </table>
                        <% } else { %>
                            <p class="no-items">No HR records found.</p>
                            <% } %>
                </center>
                <% } %>


                    <center>
                        <% if (resources.length> 0) { %>
                            <% resources.forEach(resource=> { %>
                                <h1 class="mt-5">Budget Details(Materials)</h1>
                                <h4>Total Amount: ₹ <%= resource.totalAmount.toFixed(2) %>
                                </h4>

                                <table class="table mt-3">
                                    <thead>
                                        <tr>
                                            <th>Stage</th>
                                            <th>Total Stage Amount</th>
                                            <th>Resource Type</th>
                                            <th>Quantity</th>
                                            <th>Unit</th>
                                            <th>Amount</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% resource.stages.forEach(stage=> { %>
                                            <% stage.resources.forEach(resourceItem=> { %>
                                                <tr>
                                                    <td>
                                                        <%= stage.stage %>
                                                    </td>
                                                    <td>₹<%= stage.totalStageAmount.toFixed(2) %>
                                                    </td>
                                                    <td>
                                                        <%= resourceItem.resourceType %>
                                                    </td>
                                                    <td>
                                                        <%= resourceItem.quantity %>
                                                    </td>
                                                    <td>
                                                        <%= resourceItem.unit %>
                                                    </td>
                                                    <td>₹<%= resourceItem.amount.toFixed(2) %>
                                                    </td>
                                                </tr>
                                                <% }) %>
                                                    <% }) %>
                                    </tbody>
                                </table>
                                <% }) %>
                                    <% } else { %>
                                        <p class="no-items">No budget details found.</p>
                                        <% } %>
                    </center>
                    <!-- <center>
                        <h1 class="mt-5">Budget Breakdown</h1>
                        <canvas id="budgetChart" width="500" height="500"></canvas>
                    </center> -->
                    <center>
                        <h1 class="mt-5">Materials Expenditure by Stage</h1>
                        <canvas id="stageMaterialChart" width="400" height="200"></canvas>
                    </center>
                    <center>
                        <h1 class="mt-5">Total Amounts Spent</h1>
                        <div class="row">
                            <div class="col-md-4">
                                <div class="card text-center mb-4"
                                    style="background-color: rgb(245, 190, 9); border: 1px solid rgba(255, 255, 255, 0.2);">
                                    <div class="card-header" style="background-color: rgb(245, 190, 9); color: white;">
                                        Total Amount Spent on Materials
                                    </div>
                                    <div class="card-body">
                                        <h4 class="card-title">₹ <%= resources.reduce((total, resource)=> total +
                                                resource.totalAmount, 0).toLocaleString(undefined, {
                                                minimumFractionDigits: 2 }) %></h4>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="card text-center mb-4"
                                    style="background-color: rgb(245, 190, 9); border: 1px solid rgba(255, 255, 255, 0.2);">
                                    <div class="card-header" style="background-color: rgb(245, 190, 9); color: white;">
                                        Total Amount Spent on Contractors
                                    </div>
                                    <div class="card-body">
                                        <h4 class="card-title">₹ <%= contractors.reduce((total, contractor)=> total +
                                                contractor.costEstimate, 0).toLocaleString(undefined, {
                                                minimumFractionDigits: 2 }) %></h4>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="card text-center mb-4"
                                    style="background-color: rgb(245, 190, 9); border: 1px solid rgba(255, 255, 255, 0.2);">
                                    <div class="card-header" style="background-color: rgb(245, 190, 9); color: white;">
                                        Total Amount Spent on Human Resources
                                    </div>
                                    <div class="card-body">
                                        <h4 class="card-title">₹ <%= hrSchema.reduce((total, hr)=> total + (hr.salary ||
                                                0), 0).toLocaleString(undefined, { minimumFractionDigits: 2 }) %></h4>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="card text-center mb-4"
                            style="background-color: rgb(245, 190, 9); border: 1px solid rgba(255, 255, 255, 0.2);">
                            <div class="card-header" style="background-color: rgb(245, 190, 9); color: white;">
                                Total Amount Spent (Materials + Contractors + Human Resources)
                            </div>
                            <div class="card-body">
                                <h4 class="card-title">
                                    ₹ <%= (resources.reduce((total, resource)=> total + resource.totalAmount, 0)
                                        + contractors.reduce((total, contractor) => total + contractor.costEstimate, 0)
                                        + hrSchema.reduce((total, hr) => total + (hr.salary || 0), 0)
                                        ).toLocaleString(undefined, { minimumFractionDigits: 2 }) %>
                                </h4>
                            </div>
                        </div>
                    </center>
                 






                    <div class="dashboard-btn">
                        <button id="download" class="btn btn-warning">Download Report</button>
                    </div>
        </div>

        <script src="https://code.jquery.com/jquery-3.5.1.slim.min.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.9.3/dist/umd/popper.min.js"></script>
        <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>

        <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

        <script>
            const ctx = document.getElementById('milestoneChart').getContext('2d');

            // Data for each milestone
            const milestoneData = {
                labels: [<% items.forEach(item => { %><% item.stages.forEach((stage, index, array) => { %> '<%= stage.name %>' <%= index < array.length - 1 ? ',' : '' %><% }) %><% }) %>],

                datasets: [{
                    label: 'Milestone Duration (Days)',
                    color: '#000',
                    data: [
                        <% items.forEach(item => { %>
                            <% item.stages.forEach(stage => {
                        if (stage.actual.start && stage.actual.end) {
                            let duration = Math.floor((new Date(stage.actual.end) - new Date(stage.actual.start)) / (1000 * 60 * 60 * 24));
                                    %> <%= duration %>, <% 
                                } else { %> 0, <% }
                    }) %>
                        <% }) %>
                    ],
                    backgroundColor: 'rgba(255, 206, 86, 0.7)', // Bright yellow color
                    borderColor: 'rgba(255, 159, 64, 1)', // Bright orange color for border
                    borderWidth: 1
                }]
            };

            // Create a horizontal bar chart with X and Y labels
            const milestoneChart = new Chart(ctx, {
                type: 'bar',
                data: milestoneData,
                options: {
                    plugins: {
                        legend: {
                            labels: {
                                color: 'black' // Change the legend label color to black
                            }
                        }
                    },
                    scales: {
                        x: {
                            beginAtZero: true,
                            title: {
                                display: true,
                                text: 'Milestones', // Label for X-axis
                                color: '#000' // Change X-axis label color to black
                            },
                            ticks: {
                                color: '#000' // Change X-axis tick labels to black
                            }
                        },
                        y: {
                            title: {
                                display: true,
                                text: 'Duration (Days)', // Label for Y-axis
                                color: '#000' // Change Y-axis label color to black
                            },
                            ticks: {
                                color: '#000' // Change Y-axis tick labels to black
                            }
                        }
                    }
                }
            });
        </script>
        <script>
            document.getElementById('download').addEventListener('click', function () {
                // Get the content to print
                var content = document.getElementById('content-to-print').innerHTML;

                // Create a new Blob for the Word document
                var blob = new Blob(['\ufeff', content], {
                    type: 'application/msword'
                });

                // Create a link element
                var link = document.createElement('a');
                link.href = URL.createObjectURL(blob);
                link.download = 'report.doc'; // Filename for the download

                // Append to the body
                document.body.appendChild(link);
                link.click(); // Trigger the download

                // Clean up
                document.body.removeChild(link);
            });
        </script>



        <script>
            // Chart for stage-wise material expenditure
            const stageCtx = document.getElementById('stageMaterialChart').getContext('2d');

            // Data for materials spent on each stage
            const stageMaterialData = {
                labels: [<% resources.forEach(resource => { %><% resource.stages.forEach((stage, index, array) => { %> '<%= stage.stage %>' <%= index < array.length - 1 ? ',' : '' %><% }) %><% }) %>],
                datasets: [{
                    label: 'Amount Spent on Materials (₹)',
                    data: [
                <% resources.forEach(resource => { %>
                    <% resource.stages.forEach(stage => { %>
                        <%= stage.totalStageAmount %>, 
                    <% }) %>
                <% }) %>
            ],
                    backgroundColor: 'rgba(54, 162, 235, 0.7)', // Blue color for bars
                    borderColor: 'rgba(54, 162, 235, 1)', // Blue color for border
                    borderWidth: 1
                }]
            };

            // Create bar chart for materials spent by stage
            const stageMaterialChart = new Chart(stageCtx, {
                type: 'bar',
                data: stageMaterialData,
                options: {
                    plugins: {
                        legend: {
                            labels: {
                                color: 'black' // Change the legend label color to black
                            }
                        }
                    },
                    scales: {
                        x: {
                            title: {
                                display: true,
                                text: 'Stages', // Label for X-axis
                                color: '#000' // Change X-axis label color to black
                            },
                            ticks: {
                                color: '#000' // Change X-axis tick labels to black
                            }
                        },
                        y: {
                            title: {
                                display: true,
                                text: 'Amount (₹)', // Label for Y-axis
                                color: '#000' // Change Y-axis label color to black
                            },
                            ticks: {
                                color: '#000' // Change Y-axis tick labels to black
                            }
                        }
                    }
                }
            });
        </script>




    </body>

    </html>